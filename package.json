{
  "name": "chess-analyzer-v1",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "prepare-engines": "node scripts/prepare-stockfish.mjs",
    "predev": "npm run prepare-engines",
    "dev": "vite",
    "prebuild": "npm run prepare-engines",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node --test tests/*.test.mjs",
    "calibration:extract": "node scripts/calibration/extract-reference.mjs",
    "calibration:benchmark": "node scripts/calibration/benchmark-model.mjs",
    "calibration:fit": "node scripts/calibration/fit-model.mjs",
    "calibration:check": "node scripts/calibration/benchmark-supervised.mjs --check",
    "calibration:accept": "node scripts/calibration/accept-baseline.mjs",
    "calibration:import-chess-review": "node scripts/calibration/import-chess-review.mjs",
    "calibration:supervised": "node scripts/calibration/benchmark-supervised.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "stockfish": "18.0.8"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
